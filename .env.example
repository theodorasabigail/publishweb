# ---------------------------------------------------------------------------
# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# See docs/OPERATOR_SETUP.md for click-by-click instructions.
# ---------------------------------------------------------------------------

# --- Supabase (Step 1) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://publishcoffee.com

# --- Payments (Step 4) ---
# One of: xendit | manual_transfer
PAYMENT_PROVIDER=xendit

# Path A - Xendit (primary)
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_WEBHOOK_TOKEN=your-xendit-callback-verification-token

# Path B - static QRIS + kode unik + Moota (domestic fallback)
MOOTA_WEBHOOK_SECRET=your-moota-secret
MANUAL_TRANSFER_BANK_NAME=BCA
MANUAL_TRANSFER_ACCOUNT_NUMBER=1234567890
MANUAL_TRANSFER_ACCOUNT_NAME=PT Aroma Pulau Arunika
MANUAL_TRANSFER_QRIS_IMAGE_URL=

# --- Shipping (optional; flat zones are the default and need nothing) ---
# One of: flat_zones | biteship
SHIPPING_PROVIDER=flat_zones

# Biteship, when SHIPPING_PROVIDER=biteship.
# Tokens are prefixed biteship_test. or biteship_live. — the app checks the
# prefix so a live key cannot be used by accident in a test deploy.
BITESHIP_API_KEY=biteship_test....

# Biteship does not document a webhook signature, so the callback URL carries
# a shared secret instead. Generate a long random string and configure the URL
# in their dashboard as:
#   https://your-domain.com/api/webhooks/biteship?token=<this value>
BITESHIP_WEBHOOK_SECRET=

# Which couriers to ask for a price, comma-separated.
BITESHIP_COURIERS=jne,sicepat,anteraja,jnt,pos

# By default only services that COLLECT from the roastery are offered. Set this
# to true to also accept drop-off-only services, which are often much cheaper
# but mean someone has to take the parcel to a depot.
BITESHIP_ALLOW_DROP_OFF=false

# Only for pointing at a mock during testing. Leave unset in production.
# BITESHIP_API_BASE=

# --- Pre-launch ---
# true hides the shop behind a coming-soon page. The admin, sign-in and all
# API routes keep working, so you can set the shop up before opening it.
COMING_SOON=false

# Optional. Lets you show the real site to someone before launch: send them
# https://your-domain.com/?preview=<this value> and it stays visible for them
# for 30 days. Leave blank if you do not need it.
COMING_SOON_PREVIEW_SECRET=
