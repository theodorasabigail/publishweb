# ---------------------------------------------------------------------------
# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# See docs/OPERATOR_SETUP.md for click-by-click instructions.
# ---------------------------------------------------------------------------

# --- Supabase (Step 1) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://publishcoffee.com

# --- Payments (Step 4) ---
# One of: xendit | manual_transfer
PAYMENT_PROVIDER=xendit

# Path A - Xendit (primary)
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_WEBHOOK_TOKEN=your-xendit-callback-verification-token

# Path B - static QRIS + kode unik + Moota (domestic fallback)
MOOTA_WEBHOOK_SECRET=your-moota-secret
MANUAL_TRANSFER_BANK_NAME=BCA
MANUAL_TRANSFER_ACCOUNT_NUMBER=1234567890
MANUAL_TRANSFER_ACCOUNT_NAME=PT Aroma Pulau Arunika
MANUAL_TRANSFER_QRIS_IMAGE_URL=

# --- Shipping (optional; flat zones are the default and need nothing) ---
# One of: flat_zones | biteship
SHIPPING_PROVIDER=flat_zones

# Biteship, when SHIPPING_PROVIDER=biteship.
# Tokens are prefixed biteship_test. or biteship_live. — the app checks the
# prefix so a live key cannot be used by accident in a test deploy.
BITESHIP_API_KEY=biteship_test....
